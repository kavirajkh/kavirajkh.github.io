---
interface Props {
  sectionId: string;
  title: string;
  listId: string;
}

const { sectionId, title, listId } = Astro.props;
---

<section id={sectionId} class="card comments-card">
  <h2>{title}</h2>
  <ul id={listId} class="comments-list"></ul>
</section>

<style>
  .comments-card h2 {
    font-size: var(--fs-lg);
  }

  .comments-list {
    display: grid;
    gap: var(--space-sm);
  }

  .comments-list li {
    background: var(--color-bg-subtle);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius-sm);
    padding: var(--space-sm) var(--space-md);
    color: var(--color-text-secondary);
    font-size: var(--fs-sm);
  }
</style>
