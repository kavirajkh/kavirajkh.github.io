---
import { profile } from '../data/profile';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p>&copy; {year} {profile.name}</p>
    <p class="site-footer__tagline">Engineered with the same precision I bring to every project.</p>
    <p class="site-footer__visitors" id="visitor-count" hidden>
      <span id="visitor-count-value"></span> visitors
    </p>
  </div>
</footer>

<script is:inline>
  (function () {
    var wrap = document.getElementById('visitor-count');
    var out = document.getElementById('visitor-count-value');
    if (!wrap || !out) return;
    fetch('https://kavirajkh.goatcounter.com/counter/TOTAL.json')
      .then(function (r) {
        return r.ok ? r.json() : Promise.reject();
      })
      .then(function (d) {
        var n = d ? parseInt(String(d.count_unique).replace(/\D/g, ''), 10) : 0;
        if (!n || n < 10) return;
        out.textContent = d.count_unique;
        wrap.hidden = false;
      })
      .catch(function () {});
  })();
</script>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-subtle);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm) var(--space-md);
    padding-block: var(--space-lg);
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }

  .site-footer__tagline {
    font-style: italic;
  }
</style>
