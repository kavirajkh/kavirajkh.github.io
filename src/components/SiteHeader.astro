---
import ThemeToggle from './ThemeToggle.astro';

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/experience/', label: 'Experience' },
  { href: '/projects/', label: 'Projects' },
  { href: '/skills/', label: 'Skills' },
  { href: '/peer-feedback/', label: 'Peer Feedback' },
  { href: '/contact/', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href="/" aria-label="Kaviraj Kuzhikkattu Haridasan">
      <span class="site-header__badge" aria-hidden="true">KK</span>
      <span class="site-header__brand-name site-header__brand-name--full"
        >Kaviraj Kuzhikkattu Haridasan</span
      >
      <span class="site-header__brand-name site-header__brand-name--short">Kaviraj Kuzhikkattu</span
      >
    </a>
    <nav class="site-header__nav" id="site-nav" aria-label="Primary">
      <ul>
        {
          navItems.map((item) => {
            const isActive =
              item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
            return (
              <li>
                <a href={item.href} aria-current={isActive ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
    <ThemeToggle />
    <button
      class="site-header__toggle"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Toggle navigation menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-surface-translucent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding-block: var(--space-sm);
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-width: 0;
    margin-right: auto;
    font-weight: 700;
    font-size: var(--fs-lg);
    letter-spacing: -0.01em;
  }

  .site-header__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, var(--color-accent), var(--color-accent-hover));
    color: var(--color-accent-contrast);
    font-size: var(--fs-xs);
    font-weight: 700;
  }

  .site-header__brand-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .site-header__brand-name--short {
    display: none;
  }

  @media (max-width: 480px) {
    .site-header__brand-name--full {
      display: none;
    }

    .site-header__brand-name--short {
      display: inline;
    }
  }

  .site-header__nav ul {
    display: flex;
    gap: var(--space-lg);
  }

  .site-header__nav a {
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
    padding-block: var(--space-2xs);
    border-bottom: 2px solid transparent;
  }

  .site-header__nav a:hover,
  .site-header__nav a[aria-current='page'] {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  .site-header__toggle {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    /* 44x44 is Apple's HIG minimum recommended tap target size. */
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    padding: 0;
  }

  .site-header__toggle span {
    width: 22px;
    height: 2px;
    background: var(--color-text);
    border-radius: 2px;
  }

  @media (max-width: 720px) {
    .site-header__toggle {
      display: flex;
    }

    .site-header__nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
      display: none;
    }

    .site-header__nav.is-open {
      display: block;
    }

    .site-header__nav ul {
      flex-direction: column;
      gap: 0;
      padding: var(--space-sm) var(--space-md) var(--space-md);
    }

    .site-header__nav li {
      border-top: 1px solid var(--color-border);
    }

    .site-header__nav a {
      display: block;
      padding-block: var(--space-sm);
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('site-nav');

  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });
</script>
