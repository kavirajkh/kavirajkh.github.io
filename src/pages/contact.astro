---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { profile } from '../data/profile';

const title = 'Contact';
const description = `Get in touch with ${profile.name} via email or LinkedIn.`;
---

<BaseLayout title={title} description={description} path="/contact/">
  <SiteHeader />
  <main id="main">
    <section class="section">
      <div class="container container--narrow">
        <p class="section-kicker">Get in Touch</p>
        <h1 class="section-heading">Contact</h1>
        <p class="section-intro">
          Open to Staff/Senior backend engineering conversations. Email or LinkedIn are the best
          ways to reach me.
        </p>

        <div class="contact-list">
          <a class="card contact-card" href={`mailto:${profile.email}`}>
            <span class="contact-card__label">Email</span>
            <span class="contact-card__value">{profile.email}</span>
          </a>
          <a
            class="card contact-card"
            href={profile.linkedin}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="contact-card__label">LinkedIn</span>
            <span class="contact-card__value">linkedin.com/in/kavirajkh</span>
          </a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .contact-list {
    display: grid;
    gap: var(--space-md);
  }

  .contact-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .contact-card__label {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .contact-card__value {
    font-size: var(--fs-lg);
    font-weight: 600;
    color: var(--color-accent);
  }
</style>
